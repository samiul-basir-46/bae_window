<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Header Row -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="7dp">

        <!-- Status Indicator ("• Paired") -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:background="@drawable/widget_status_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <!-- Green dot replaced with small TextView for compatibility -->
            <TextView
                android:id="@+id/status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="#67F6B3"
                android:visibility="visible" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:letterSpacing="0.08"
                android:text="CONNECTED"
                android:textColor="#E8FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sender name ("from Arif") -->
        <TextView
            android:id="@+id/sender_name_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:maxLines="1"
            android:text="from Bae"
            android:textColor="#A8FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Latest content only: image, drawing, or voice -->
    <FrameLayout
        android:id="@+id/center_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footer_layout"
        android:layout_below="@+id/header_layout"
        android:background="@drawable/widget_page_background"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_photo_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Latest photo from partner"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_drawing_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Latest drawing from partner"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_media_scrim"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_gravity="bottom"
            android:background="@drawable/widget_media_scrim"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_content_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/widget_content_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_icon_image"
                android:gravity="center"
                android:text="📷"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/widget_content_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="No shared moment yet"
                android:textColor="#F5FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_content_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="Open Bae Window to share"
                android:textColor="#8AFFFFFF"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_content_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="8dp"
            android:background="@drawable/widget_badge_image"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:text="IMAGE"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_content_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="A fresh moment from Bae"
            android:textColor="#F4FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Footer Row -->
    <RelativeLayout
        android:id="@+id/footer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="7dp"
        android:background="@drawable/widget_footer_background"
        android:paddingHorizontal="7dp"
        android:paddingVertical="5dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Small Round Avatar -->
            <TextView
                android:id="@+id/avatar_circle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_avatar_background"
                android:gravity="center"
                android:text="B"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:id="@+id/footer_description"
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bae sent a photo"
                android:textColor="#F0FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Timestamp -->
        <TextView
            android:id="@+id/widget_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Just now"
            android:textColor="#78FFFFFF"
            android:textSize="8sp" />
    </RelativeLayout>

</RelativeLayout>
