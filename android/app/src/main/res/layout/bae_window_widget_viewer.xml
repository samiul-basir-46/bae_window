<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A151A"
    android:padding="12dp">

    <!-- Header Row -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="8dp">

        <!-- Status Indicator ("• Paired") -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Green dot replaced with small TextView for compatibility -->
            <TextView
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#4CAF50"
                android:visibility="visible" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="Paired"
                android:textColor="#A0FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sender name ("from Arif") -->
        <TextView
            android:id="@+id/sender_name_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="from Bae"
            android:textColor="#60FFFFFF"
            android:textSize="11sp" />
    </RelativeLayout>

    <!-- Swipeable image, drawing and voice pages -->
    <FrameLayout
        android:id="@+id/center_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footer_layout"
        android:layout_below="@+id/header_layout">

        <StackView
            android:id="@+id/widget_stack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateFirstView="true"
            android:loopViews="true" />
    </FrameLayout>

    <!-- Footer Row -->
    <RelativeLayout
        android:id="@+id/footer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Small Round Avatar -->
            <TextView
                android:id="@+id/avatar_circle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="#806A82FF"
                android:gravity="center"
                android:text="B"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:id="@+id/footer_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="Bae sent a photo"
                android:textColor="#E0FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Timestamp -->
        <TextView
            android:id="@+id/widget_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="Just now"
            android:textColor="#60FFFFFF"
            android:textSize="10sp" />
    </RelativeLayout>

</RelativeLayout>
