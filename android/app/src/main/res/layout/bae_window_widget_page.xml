<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#241E26">

    <ImageView
        android:id="@+id/widget_page_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Shared content"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_page_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_page_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/widget_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="No photo yet"
            android:textColor="#EFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_page_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Open Bae Window to share"
            android:textColor="#70FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_page_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_margin="7dp"
        android:background="#B0000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="Image"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="5dp"
        android:background="#80000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="Swipe ↔"
        android:textColor="#B0FFFFFF"
        android:textSize="8sp" />

</FrameLayout>
